{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install uv && uv pip install --system -r <(uv pip compile pyproject.toml -o -)",
    "nixpacks": { "aptPackages": ["tesseract-ocr", "tesseract-ocr-por"] }
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health"
  }
}
