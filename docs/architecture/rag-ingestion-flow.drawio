        <mxCell id="i4" value="&lt;b&gt;4. Enqueue Job&lt;/b&gt;&lt;br&gt;Arq → Redis&lt;br&gt;by source_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#92400e;arcSize=8;" vertex="1" parent="1">
