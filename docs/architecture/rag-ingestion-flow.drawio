        <mxCell id="fg-title" value="&lt;b&gt;FLASHCARD GENERATION &amp; REVIEW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#ec4899;fontSize=14;fontStyle=1;fontColor=#be185d;arcSize=5;" vertex="1" parent="1">
