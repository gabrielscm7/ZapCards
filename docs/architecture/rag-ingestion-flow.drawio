        <mxCell id="f4" value="&lt;b&gt;Review (FSRS)&lt;/b&gt;&lt;br&gt;POST /flashcards/review&lt;br&gt;rating → stability, difficulty, next_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f9a8d4;fontSize=11;fontColor=#be185d;arcSize=8;" vertex="1" parent="1">
