        <mxCell id="r1" value="&lt;b&gt;1. User Query&lt;/b&gt;&lt;br&gt;POST /api/chat&lt;br&gt;{ content: "pergunta" }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=11;fontColor=#166534;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="690" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="r2" value="&lt;b&gt;2. Vectorize Query&lt;/b&gt;&lt;br&gt;embed_query(text)&lt;br&gt;SentenceTransformer&lt;br&gt;BAAI/bge-m3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=11;fontColor=#166534;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="690" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="r3" value="&lt;b&gt;3. Vector Search&lt;/b&gt;&lt;br&gt;search_similar()&lt;br&gt;Cosine distance (<=>)&lt;br&gt;HNSW index&lt;br&gt;TOP 5 results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=11;fontColor=#166534;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="685" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="r4-diamond" value="&lt;b&gt;Threshold&lt;/b&gt;&lt;br&gt;≥ 0.70?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=11;fontColor=#92400e;arcSize=5;" vertex="1" parent="1">
