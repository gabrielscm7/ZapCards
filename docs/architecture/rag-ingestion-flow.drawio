        </mxCell>

        <mxCell id="i3" value="&lt;b&gt;3. Note Created&lt;/b&gt;&lt;br&gt;content_md = placeholder&lt;br&gt;source_type set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#92400e;arcSize=8;" vertex="1" parent="1">
