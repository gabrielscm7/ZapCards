        <!-- Upload -->
        <mxCell id="i1" value="&lt;b&gt;1. Upload&lt;/b&gt;&lt;br&gt;JPEG/PNG/PDF&lt;br&gt;DOCX/CSV&lt;br&gt;MP3/MP4/WAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#92400e;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="160" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="i2" value="&lt;b&gt;2. Storage&lt;/b&gt;&lt;br&gt;S3 / Local&lt;br&gt;save_file()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#92400e;arcSize=8;" vertex="1" parent="1">
