        <mxCell id="i5-pdf" value="&lt;b&gt;5b. Document&lt;/b&gt;&lt;br&gt;MarkItDown&lt;br&gt;PDF/DOCX → MD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontSize=11;fontColor=#9a3412;arcSize=8;" vertex="1" parent="1">
