        <mxCell id="f1" value="&lt;b&gt;Generate&lt;/b&gt;&lt;br&gt;POST /flashcards/generate&lt;br&gt;note_ids + difficulty + quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f9a8d4;fontSize=11;fontColor=#be185d;arcSize=8;" vertex="1" parent="1">
