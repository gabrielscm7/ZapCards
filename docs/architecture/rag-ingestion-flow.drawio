        <mxCell id="rag-title" value="&lt;b&gt;RAG PIPELINE (Query → Response)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontSize=14;fontStyle=1;fontColor=#166534;arcSize=5;" vertex="1" parent="1">
