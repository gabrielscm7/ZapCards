        <mxCell id="f5" value="&lt;b&gt;Due Cards&lt;/b&gt;&lt;br&gt;GET /flashcards/due&lt;br&gt;WHERE next_review <= now()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f9a8d4;fontSize=11;fontColor=#be185d;arcSize=8;" vertex="1" parent="1">
