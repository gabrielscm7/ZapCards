        </mxCell>

        <mxCell id="i5-audio" value="&lt;b&gt;5c. Audio/Video&lt;/b&gt;&lt;br&gt;Groq Whisper v3&lt;br&gt;Audio → Text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontSize=11;fontColor=#9a3412;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="350" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="i6" value="&lt;b&gt;6. Update Note&lt;/b&gt;&lt;br&gt;update_note_content()&lt;br&gt;content_md = processed text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#92400e;arcSize=8;" vertex="1" parent="1">
