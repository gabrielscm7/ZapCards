        <mxCell id="r5-no" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;"Nao tenho info&lt;br&gt;suficiente"" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontSize=11;fontColor=#991b1b;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="810" width="170" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="r6" value="&lt;b&gt;5. Build Context&lt;/b&gt;&lt;br&gt;chunk_content_1 + chunk_content_2 ...&lt;br&gt;+ system_prompt (restritivo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=11;fontColor=#166534;arcSize=8;" vertex="1" parent="1">
