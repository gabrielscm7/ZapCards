# ZapCards — Environment Variables
# Copiar para .env e preencher os valores

# Railway fornece DATABASE_URL e REDIS_URL automaticamente
# As variaveis abaixo sao para desenvolvimento local

# PostgreSQL (Railway provisiona automaticamente em prod)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zapcards

# Redis (Railway provisiona automaticamente em prod)
REDIS_URL=redis://localhost:6379/0

# Groq API (inferencia LLM, Whisper, Vision)
GROQ_API_KEY=

# S3-compatible storage (Railway Buckets em prod, MinIO em dev)
S3_ENDPOINT=
S3_BUCKET=zapcards-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# WhatsApp (Baileys no MVP — nao precisa de token)
# Numero do WhatsApp para pairing code (ex: 5511999999999):
WHATSAPP_PHONE_NUMBER=
# Para Cloud API oficial (futuro):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# RAG
SIMILARITY_THRESHOLD=0.70
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Backend
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Development mode — skip S3 and use local file storage
DEV_USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./uploads
